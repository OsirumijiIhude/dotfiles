#!/usr/bin/env bash
# Copies the files listed in FILES from my system into this repo (home/...), then shows what
# changed. Commit and push after. Run: ./sync
set -euo pipefail
cd "$(dirname "$0")"
while read -r path; do
    [[ -z "$path" || "$path" == \#* ]] && continue
    if [ -f "$HOME/$path" ]; then
        mkdir -p "home/$(dirname "$path")"
        cp -p "$HOME/$path" "home/$path"
    else
        echo "not on this machine: $path"
    fi
done < FILES
git status --short
