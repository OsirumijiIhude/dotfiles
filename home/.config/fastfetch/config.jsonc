/*
Single-section HyDE fastfetch layout (customised). Helpers in ~/.local/bin:
  quote (tech quote header), netspeed (internet speed + chess ping), ai-usage (Claude/Codex limits left)
Previous versions: config.jsonc.bak-*
*/
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/icons/Wallbash-Icon/distro/archlinux.png",
    "type": "kitty",
    "height": 16,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "  󰀄  {6}{7}{8}",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 1"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 2"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 3"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 4"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 5"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 6"
    },
    {
      "type": "command",
      "key": " ",
      "text": "quote --line 7"
    },
    "break",
    {
      "type": "custom",
      "format": "  {#90}──{#} {#1;35}󰒓  System{#} {#90}───────────────────────────────────────────────────────{#}"
    },
    {
      "type": "command",
      "key": "  󰣇  OS       ",
      "keyColor": "red",
      "text": ". /etc/os-release; echo \"$NAME · kernel $(uname -r)\""
    },
    {
      "type": "packages",
      "key": "  󰏖  Packages ",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": "  󰍹  Displays ",
      "keyColor": "green",
      "text": "hyprctl monitors -j | jq -r 'map(\"\\(.width)x\\(.height) @ \\(.refreshRate|round)Hz\") | group_by(.) | map(\"\\(length)× \\(.[0])\") | join(\", \")'"
    },
    {
      "type": "terminal",
      "key": "  󰆍  Session  ",
      "keyColor": "yellow",
      "format": "{pretty-name} {version} · Hyprland"
    },
    "break",
    {
      "type": "custom",
      "format": "  {#90}──{#} {#1;34}󰘚  Hardware{#} {#90}─────────────────────────────────────────────────────{#}"
    },
    {
      "type": "cpu",
      "key": "  󰻠  CPU      ",
      "keyColor": "blue",
      "format": "{1} @ {7}"
    },
    {
      "type": "gpu",
      "key": "  󰊴  GPU      ",
      "keyColor": "blue",
      "format": "{name} · {driver}"
    },
    {
      "type": "memory",
      "key": "  󰍛  Memory   ",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "  󱎫  Uptime   ",
      "keyColor": "red",
      "text": "awk -v b=$(stat -c %W /) -v now=$(date +%s) '{u=int($1); printf \"%dd %dh %dm · OS installed %d days ago\\n\", u/86400, u%86400/3600, u%3600/60, (now-b)/86400}' /proc/uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "  {#90}──{#} {#1;36}󰅟  Network{#} {#90}──────────────────────────────────────────────────────{#}"
    },
    {
      "type": "command",
      "key": "  󰖟  Internet ",
      "keyColor": "cyan",
      "text": "netspeed network"
    },
    {
      "type": "command",
      "key": "  󰚩  Claude   ",
      "keyColor": "yellow",
      "text": "ai-usage claude"
    },
    {
      "type": "command",
      "key": "  󰚩  Codex    ",
      "keyColor": "green",
      "text": "ai-usage codex"
    },
    {
      "type": "custom",
      "format": "  {#90}────────────────────────────────────────────────────────────────────{#}"
    },
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "circle"
    }
  ]
}
