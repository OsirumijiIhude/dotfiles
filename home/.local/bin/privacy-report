#!/usr/bin/env python3
"""Microphone / camera usage report (opened by clicking the waybar privacy dot).

Shows what is using the mic/camera right now, then the last 7 days:
per-app totals, a per-day chart, an hour-of-day pattern and recent sessions.
Data: ~/.local/share/privacy-monitor/sessions.jsonl (written by privacy-monitor).
"""
import json
import os
import sys
import time
from collections import defaultdict
from datetime import datetime, timedelta

DATA = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "privacy-monitor")
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "privacy")
DAYS = 7

B, DIM, R = "\033[1m", "\033[2m", "\033[0m"
COL = {"mic": "\033[38;2;255;159;10m", "camera": "\033[38;2;48;209;88m"}
ICON = {"mic": "🎙", "camera": "📷"}
LABEL = {"mic": "Microphone", "camera": "Camera"}


def dur(s):
    s = int(s)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m {s % 60:02d}s"
    return f"{s // 3600}h {s % 3600 // 60:02d}m"


def load():
    now = time.time()
    sessions = []
    try:
        with open(os.path.join(DATA, "sessions.jsonl")) as f:
            for line in f:
                try:
                    sessions.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        pass
    # include ongoing sessions up to now
    try:
        with open(os.path.join(DATA, "open.json")) as f:
            for key, v in json.load(f).items():
                kind, app = key.split("\t", 1)
                sessions.append({"kind": kind, "app": app, "start": v["start"], "end": now, "ongoing": True})
    except (OSError, ValueError):
        pass
    cutoff = now - DAYS * 86400
    return [s for s in sessions if s["end"] >= cutoff], cutoff


def bar(value, maxv, width, color):
    if maxv <= 0 or value <= 0:
        return ""
    n = max(1, round(value / maxv * width))
    return color + "█" * n + R


def main():
    sessions, cutoff = load()
    now = time.time()
    cols = min(os.get_terminal_size().columns if sys.stdout.isatty() else 100, 110)

    print(f"\n  {B}Privacy — microphone & camera access{R}  {DIM}(last {DAYS} days){R}\n")

    # --- now
    try:
        with open(os.path.join(RUNTIME, "state.json")) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {"mic": [], "camera": []}
    print(f"  {B}Right now{R}")
    if not st.get("mic") and not st.get("camera"):
        print(f"    {DIM}Nothing is using the microphone or camera.{R}")
    for kind in ("camera", "mic"):
        for app in st.get(kind, []):
            ongoing = [s for s in sessions if s.get("ongoing") and s["kind"] == kind and s["app"] == app]
            since = f" for {dur(now - ongoing[0]['start'])}" if ongoing else ""
            print(f"    {COL[kind]}●{R} {ICON[kind]} {LABEL[kind]}: {B}{app}{R}{since}")
    print()

    if not sessions:
        print(f"  {DIM}No microphone or camera use recorded yet.{R}\n")
        return

    # --- per app totals
    print(f"  {B}By app{R}")
    totals = defaultdict(lambda: {"secs": 0.0, "n": 0, "last": 0.0})
    for s in sessions:
        t = totals[(s["kind"], s["app"])]
        t["secs"] += s["end"] - max(s["start"], cutoff)
        t["n"] += 1
        t["last"] = max(t["last"], s["end"])
    maxsecs = max(t["secs"] for t in totals.values())
    for (kind, app), t in sorted(totals.items(), key=lambda kv: -kv[1]["secs"]):
        last = "now" if now - t["last"] < 5 else datetime.fromtimestamp(t["last"]).strftime("%a %H:%M")
        print(f"    {COL[kind]}●{R} {ICON[kind]} {app[:22]:<22} {dur(t['secs']):>9}  {t['n']:>3}×  "
              f"{DIM}last {last:<9}{R} {bar(t['secs'], maxsecs, 20, COL[kind])}")
    print()

    # --- per day
    print(f"  {B}Per day{R}  {COL['mic']}■{R} mic  {COL['camera']}■{R} camera")
    days = []
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    for i in range(DAYS - 1, -1, -1):
        d0 = today - timedelta(days=i)
        days.append((d0, d0.timestamp(), (d0 + timedelta(days=1)).timestamp()))
    per_day = []
    for d0, a, b in days:
        v = {"mic": 0.0, "camera": 0.0}
        for s in sessions:
            ov = min(s["end"], b) - max(s["start"], a)
            if ov > 0:
                v[s["kind"]] += ov
        per_day.append((d0, v))
    maxd = max(max(v.values()) for _, v in per_day) or 1
    width = max(10, (cols - 40) // 2)
    for d0, v in per_day:
        label = "Today" if d0 == today else d0.strftime("%a %d")
        print(f"    {label:<7} {COL['mic']}{dur(v['mic']) if v['mic'] else '–':>8}{R} {bar(v['mic'], maxd, width, COL['mic']):<{width}}"
              f"  {COL['camera']}{dur(v['camera']) if v['camera'] else '–':>8}{R} {bar(v['camera'], maxd, width, COL['camera'])}")
    print()

    # --- hour of day pattern
    print(f"  {B}Time of day{R}  {DIM}(minutes per hour slot, all {DAYS} days){R}")
    hours = defaultdict(float)
    for s in sessions:
        t = max(s["start"], cutoff)
        while t < s["end"]:
            h = datetime.fromtimestamp(t)
            nxt = (h.replace(minute=0, second=0, microsecond=0) + timedelta(hours=1)).timestamp()
            hours[h.hour] += min(nxt, s["end"]) - t
            t = nxt
    blocks = " ▁▂▃▄▅▆▇█"
    maxh = max(hours.values()) if hours else 0
    spark = "".join(blocks[min(8, round(hours[h] / maxh * 8))] if maxh else " " for h in range(24))
    print(f"    {spark}")
    print(f"    {DIM}0     6     12    18   23{R}")
    if maxh:
        top = [kv for kv in sorted(hours.items(), key=lambda kv: -kv[1])[:3] if kv[1] >= 1]
        print(f"    {DIM}Busiest: " + ", ".join(f"{h:02d}:00 ({dur(v)})" for h, v in top) + R)
    print()

    # --- recent sessions
    print(f"  {B}Recent sessions{R}")
    for s in sorted(sessions, key=lambda s: -s["start"])[:15]:
        st_ = datetime.fromtimestamp(s["start"]).strftime("%a %d %H:%M")
        en = "now" if s.get("ongoing") else datetime.fromtimestamp(s["end"]).strftime("%H:%M")
        print(f"    {COL[s['kind']]}●{R} {st_}–{en:<5}  {dur(s['end'] - s['start']):>9}  {ICON[s['kind']]} {s['app']}")
    print()


if __name__ == "__main__":
    main()
    if sys.stdin.isatty() and "--no-wait" not in sys.argv:
        try:
            input(f"  {DIM}Press Enter to close{R}")
        except (EOFError, KeyboardInterrupt):
            pass
