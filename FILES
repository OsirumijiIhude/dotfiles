# Every file this repo tracks, as a path inside $HOME. ./sync copies these from my system into the
# repo; ./install links them back into place on a new machine. Add a line to track a new file.

# Hyprland (on top of HyDE)
.config/hypr/hyde.conf
.config/hypr/userprefs.conf
.config/hypr/keybindings.conf
.config/hypr/windowrules.conf
.config/hypr/monitors.conf
.config/hypr/hypridle.conf
.config/hypr/hyprlock.conf
.config/hypr/hyprlock/HyDE.conf
.config/hypr/hyprlock-bread.conf

# Waybar: my layout, module and styles (HyDE builds config.jsonc and style.css from these)
.config/waybar/layouts/shiri/02.jsonc
.config/waybar/modules/island.jsonc
.config/waybar/styles/shiri.css
.config/waybar/island-theme.css
.config/waybar/user-style.css

# Terminal and shell
.config/kitty/kitty.conf
.config/starship/starship.toml
.config/zsh/user.zsh
.config/zsh/.zshrc
.config/fastfetch/config.jsonc

# Scripts the configs above call
.local/bin/quote
.local/bin/youtube-fullscreen.sh
.local/bin/privacy-dot
.local/bin/privacy-report
.local/bin/privacy-monitor
.config/systemd/user/privacy-monitor.service
.config/systemd/user/mpd-mpris.service.d/port.conf
